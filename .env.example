# Copy to .env for local work. Never commit .env.
# The sample pipeline (npm run produce:sample) does not read these.

# Optional voice provider. Leave blank until a real voice stage is implemented.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Directory for large Remotion webpack bundles. Point this at a roomy disk.
REMOTION_TMP=

# External location for source recordings and finished renders (S3, R2, GCS, or a shared drive).
ASSET_BUCKET_URL=
